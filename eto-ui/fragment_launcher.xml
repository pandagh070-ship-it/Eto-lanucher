<com.kdt.mcgui.LauncherMenuButton android:id="@+id/open_files_button" android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginBottom="8dp" android:text="  Game files" android:textColor="#F3F7FB" android:backgroundTint="#1C2C3B" android:drawableStart="@drawable/ic_eto_folder"/>
