<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/fragment_menu_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#10131B"
    android:padding="14dp">

    <TextView
        android:id="@+id/eto_brand"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="ETO  /  JAVA EDITION"
        android:textColor="#F7F8FC"
        android:textSize="22sp"
        android:textStyle="bold"
        android:letterSpacing="0.08"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toStartOf="@id/news_button" />

    <com.kdt.mcgui.LauncherMenuButton
        android:id="@+id/news_button"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:text="WIKI"
        android:textColor="#A8B2C5"
        android:backgroundTint="#202635"
        android:drawableStart="@drawable/ic_px_book"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toStartOf="@id/social_media_button" />

    <com.kdt.mcgui.LauncherMenuButton
        android:id="@+id/social_media_button"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:text="COMMUNITY"
        android:textColor="#A8B2C5"
        android:backgroundTint="#202635"
        android:drawableStart="@drawable/ic_social_media"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/eto_welcome"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:text="YOUR WORLD. YOUR RULES."
        android:textColor="#63E6BE"
        android:textSize="12sp"
        android:textStyle="bold"
        android:letterSpacing="0.14"
        app:layout_constraintTop_toBottomOf="@id/eto_brand"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/eto_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Ready to play?"
        android:textColor="#FFFFFF"
        android:textSize="30sp"
        android:textStyle="bold"
        android:layout_marginTop="4dp"
        app:layout_constraintTop_toBottomOf="@id/eto_welcome"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/eto_subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Choose a version, then jump into your next world."
        android:textColor="#929DB2"
        android:textSize="14sp"
        android:layout_marginTop="4dp"
        app:layout_constraintTop_toBottomOf="@id/eto_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/eto_tools_card"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:padding="10dp"
        android:layout_marginTop="18dp"
        android:layout_marginBottom="12dp"
        android:background="#191F2D"
        app:layout_constraintTop_toBottomOf="@id/eto_subtitle"
        app:layout_constraintBottom_toTopOf="@id/mc_version_spinner"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.kdt.mcgui.LauncherMenuButton
            android:id="@+id/custom_control_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="  Controls &amp; Key Mapping"
            android:textColor="#E8ECF5"
            android:backgroundTint="#252D3E"
            android:drawableStart="@drawable/ic_px_gamepad" />

        <com.kdt.mcgui.LauncherMenuButton
            android:id="@+id/install_jar_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="  Install Java Version"
            android:textColor="#E8ECF5"
            android:backgroundTint="#252D3E"
            android:drawableStart="@drawable/ic_px_java_run" />

        <com.kdt.mcgui.LauncherMenuButton
            android:id="@+id/open_files_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="  Game Files"
            android:textColor="#E8ECF5"
            android:backgroundTint="#252D3E"
            android:drawableStart="@drawable/ic_px_folder" />

        <com.kdt.mcgui.LauncherMenuButton
            android:id="@+id/share_logs_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="  Share Debug Logs"
            android:textColor="#E8ECF5"
            android:backgroundTint="#252D3E"
            android:drawableStart="@drawable/ic_px_sharelog" />
    </LinearLayout>

    <com.kdt.mcgui.mcVersionSpinner
        android:id="@+id/mc_version_spinner"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:background="#202635"
        android:paddingStart="12dp"
        android:drawableEnd="@drawable/spinner_arrow"
        app:drawableEndSize="20dp"
        app:drawableStartIntegerScaling="true"
        app:drawableStartSize="36dp"
        app:drawableEndPadding="4dp"
        app:layout_constraintBottom_toTopOf="@id/play_button"
        app:layout_constraintEnd_toStartOf="@id/edit_profile_button"
        app:layout_constraintStart_toStartOf="parent" />

    <ImageButton
        android:id="@+id/edit_profile_button"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:background="#202635"
        android:src="@drawable/ic_px_edit"
        app:layout_constraintBottom_toBottomOf="@id/mc_version_spinner"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/mc_version_spinner" />

    <View
        android:id="@+id/_background_display_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#10131B"
        android:translationZ="-1dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="@id/mc_version_spinner"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.kdt.mcgui.MineButton
        android:id="@+id/play_button"
        android:layout_width="0dp"
        android:layout_height="62dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="4dp"
        android:backgroundTint="#63E6BE"
        android:text="PLAY"
        android:textColor="#10131B"
        android:textStyle="bold"
        android:textAllCaps="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
