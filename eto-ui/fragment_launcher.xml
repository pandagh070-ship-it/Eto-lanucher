<TextView android:id="@+id/eto_remote_message" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="News and supported content updates appear here." android:textColor="#D4DEE8" android:textSize="12sp" android:paddingTop="5dp"/>
<TextView android:id="@+id/eto_remote_version" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="CONTENT CHANNEL  •  READY" android:textColor="#8FE6C0" android:textSize="9sp" android:paddingTop="8dp"/>
</LinearLayout>
<View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>
