<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/fragment_menu_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#191919">

    <LinearLayout
        android:id="@+id/eto_sidebar"
        android:layout_width="208dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:padding="14dp"
        android:background="#292929"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ETO LAUNCHER"
            android:textColor="#F2F2F2"
            android:textSize="22sp"
            android:textStyle="bold"
            android:paddingBottom="18dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="MINECRAFT: JAVA EDITION"
            android:textColor="#A7A7A7"
            android:textSize="10sp"
            android:letterSpacing="0.08"
            android:paddingBottom="14dp" />

        <com.kdt.mcgui.LauncherMenuButton
            android:id="@+id/news_button"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="  News"
            android:textColor="#F5F5F5"
            android:backgroundTint="#3A3A3A"
            android:drawableStart="@drawable/ic_px_book" />

        <com.kdt.mcgui.LauncherMenuButton
            android:id="@+id/social_media_button"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="  Community"
            android:textColor="#E1E1E1"
            android:backgroundTint="#303030"
            android:drawableStart="@drawable/ic_social_media" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            android:background="#454545" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="PROFILES"
            android:textColor="#A8A8A8"
            android:textSize="11sp"
            android:textStyle="bold"
            android:paddingBottom="6dp" />

        <com.kdt.mcgui.LauncherMenuButton
            android:id="@+id/install_jar_button"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:text="  Add version"
            android:textColor="#E8E8E8"
            android:backgroundTint="#303030"
            android:drawableStart="@drawable/ic_px_java_run" />

        <com.kdt.mcgui.LauncherMenuButton
            android:id="@+id/custom_control_button"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:text="  Controls"
            android:textColor="#E8E8E8"
            android:backgroundTint="#303030"
            android:drawableStart="@drawable/ic_px_gamepad" />

        <com.kdt.mcgui.LauncherMenuButton
            android:id="@+id/open_files_button"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:text="  Game files"
            android:textColor="#E8E8E8"
            android:backgroundTint="#303030"
            android:drawableStart="@drawable/ic_px_folder" />

        <com.kdt.mcgui.LauncherMenuButton
            android:id="@+id/share_logs_button"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:text="  Debug logs"
            android:textColor="#E8E8E8"
            android:backgroundTint="#303030"
            android:drawableStart="@drawable/ic_px_sharelog" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <com.kdt.mcgui.mcVersionSpinner
            android:id="@+id/mc_version_spinner"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="#202020"
            android:drawableEnd="@drawable/spinner_arrow"
            app:drawableEndSize="18dp"
            app:drawableStartIntegerScaling="true"
            app:drawableStartSize="28dp"
            app:drawableEndPadding="3dp" />

        <ImageButton
            android:id="@+id/edit_profile_button"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:layout_marginTop="4dp"
            android:background="#343434"
            android:src="@drawable/ic_px_edit"
            android:contentDescription="Edit profile" />

        <com.kdt.mcgui.MineButton
            android:id="@+id/play_button"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:text="PLAY"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textAllCaps="true"
            android:backgroundTint="#00B85A" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/eto_news_area"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:padding="18dp"
        android:background="#202020"
        app:layout_constraintStart_toEndOf="@id/eto_sidebar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="LATEST NEWS"
                android:textColor="#F4F4F4"
                android:textSize="18sp"
                android:textStyle="bold" />

            <com.kdt.mcgui.LauncherMenuButton
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:text="  Settings"
                android:textColor="#DDDDDD"
                android:backgroundTint="#303030"
                android:drawableStart="@drawable/ic_px_sliders" />
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:overScrollMode="never">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="12dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="230dp"
                    android:background="@drawable/eto_news_banner">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom"
                        android:orientation="vertical"
                        android:padding="18dp"
                        android:background="#CC111111">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="ETO • MINECRAFT JAVA"
                            android:textColor="#66E5A3"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Your next world starts here"
                            android:textColor="#FFFFFF"
                            android:textSize="25sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Manage versions, profiles and launch options."
                            android:textColor="#D6D6D6"
                            android:textSize="13sp" />
                    </LinearLayout>
                </FrameLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="8dp"
                    android:text="LAUNCHER UPDATES"
                    android:textColor="#F0F0F0"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:background="#303030">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Welcome to Eto Launcher"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="A clean desktop-inspired home for Minecraft Java on Android."
                        android:textColor="#C5C5C5"
                        android:textSize="13sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Tip: choose your Minecraft profile from the left panel before pressing PLAY."
                    android:textColor="#AFAFAF"
                    android:textSize="12sp" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <View
        android:id="@+id/_background_display_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
