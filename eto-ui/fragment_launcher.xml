</LinearLayout>
<ImageButton android:id="@+id/edit_version_button" android:layout_width="42dp" android:layout_height="42dp" android:layout_marginTop="10dp" android:layout_marginEnd="108dp" android:background="#D91B2938" android:src="@drawable/ic_eto_edit" android:tint="#FFFFFF" android:contentDescription="Edit Minecraft version" android:elevation="8dp" app:layout_constraintTop_toTopOf="parent" app:layout_constraintEnd_toEndOf="parent"/>
<ImageButton android:id="@+id/eto_settings_button" android:layout_width="42dp" android:layout_height="42dp" android:layout_marginTop="10dp" android:layout_marginEnd="58dp" android:background="#D91B2938" android:src="@drawable/ic_eto_settings" android:tint="#FFFFFF" android:contentDescription="Settings" android:elevation="8dp" app:layout_constraintTop_toTopOf="parent" app:layout_constraintEnd_toEndOf="parent"/>
<ImageButton android:id="@+id/edit_profile_button" android:layout_width="42dp" android:layout_height="42dp" android:layout_marginTop="10dp" android:layout_marginEnd="8dp" android:background="#D91B2938" android:src="@drawable/ic_eto_account" android:tint="#FFFFFF" android:contentDescription="Account" android:elevation="8dp" app:layout_constraintTop_toTopOf="parent" app:layout_constraintEnd_toEndOf="parent"/>
<com.kdt.mcgui.MineButton android:id="@+id/play_button" android:layout_width="142dp" android:layout_height="52dp" android:layout_marginEnd="20dp" android:layout_marginBottom="18dp" android:text="▶  PLAY NOW" android:textColor="#07140F" android:textStyle="bold" android:textSize="14sp" android:elevation="12dp" android:backgroundTint="#8FE6C0" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintBottom_toBottomOf="parent"/>
<View android:id="@+id/_background_display_view" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>