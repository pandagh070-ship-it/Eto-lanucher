<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#12161C" android:padding="22dp">
<TextView android:id="@+id/eto_login_title" android:layout_width="0dp" android:layout_height="wrap_content" android:text="Sign in to Eto" android:textColor="#F2F5F9" android:textSize="28sp" android:textStyle="bold" app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"/>
<TextView android:id="@+id/eto_login_subtitle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Choose a player name to start your Java Edition session." android:textColor="#B8C2CE" android:textSize="14sp" app:layout_constraintTop_toBottomOf="@id/eto_login_title" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"/>
<LinearLayout android:id="@+id/login_menu" android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:padding="22dp" android:background="#1B222C" app:layout_constraintTop_toBottomOf="@id/eto_login_subtitle" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="PLAYER NAME" android:textColor="#B8C2CE" android:textSize="11sp" android:textStyle="bold" android:paddingBottom="6dp"/>
<com.kdt.mcgui.MineEditText android:id="@+id/login_edit_email" android:layout_width="match_parent" android:layout_height="48dp" android:imeOptions="flagNoExtractUi" android:inputType="textPersonName" android:hint="Enter username" android:textSize="16sp"/>
<com.kdt.mcgui.MineButton android:id="@+id/login_button" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="18dp" android:onClick="loginMC" android:text="CONTINUE" android:textColor="#1B222C" android:backgroundTint="#19A765"/>
</LinearLayout></androidx.constraintlayout.widget.ConstraintLayout>