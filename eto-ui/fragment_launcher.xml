<LinearLayout android:id="@+id/eto_news_area" android:layout_width="0dp" android:layout_height="0dp" android:orientation="vertical" android:padding="24dp" android:paddingTop="62dp" android:background="#00101820" app:layout_constraintStart_toEndOf="@id/eto_sidebar" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="ETO  /  GAME CENTER" android:textColor="#8FE6C0" android:textSize="10sp" android:textStyle="bold" android:letterSpacing="0.18"/>
