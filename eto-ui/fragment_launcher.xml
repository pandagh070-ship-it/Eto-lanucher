</LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="12dp" android:padding="16dp" android:background="#C9101925">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="ETO LIVE" android:textColor="#8FE6C0" android:textSize="10sp" android:textStyle="bold"/>
